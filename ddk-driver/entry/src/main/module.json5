{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "MainAbility",
    "deviceTypes": ["2in1"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "requestPermissions": [
      { "name": "ohos.permission.ACCESS_EXTENSIONAL_DEVICE_DRIVER" },
      { "name": "ohos.permission.ACCESS_DDK_USB" }
    ],
    "abilities": [
      {
        "name": "MainAbility",
        "srcEntry": "./ets/entryability/MainAbility.ets",
        "description": "$string:module_desc",
        "label": "$string:module_desc",
        "icon": "$media:app_icon",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": false
      }
    ],
    "extensionAbilities": [
      {
        "name": "DriverExtensionAbility",
        "srcEntry": "./ets/driverextability/DriverExtensionAbility.ets",
        "description": "$string:module_desc",
        "type": "driver",
        "exported": true,
        "metadata": [
          { "name": "bus", "value": "USB" },
          { "name": "desc", "value": "USBArc USB/IP user-space USB driver" },
          { "name": "vendor", "value": "RockyMtnWolf" },
          { "name": "vid", "value": "0x1A86,0x0483,0x1366,0x10C4,0x0403,0x303A,0x03EB,0x04D8,0x16C0,0x0781" },
          { "name": "pid", "value": "0x55D3,0x55DB,0x7523,0xEA60,0x3748,0x374E,0x05DC,0x900A,0x5591" },
          { "name": "ohos.permission.ACCESS_DDK_ALLOWED", "value": "true" }
        ]
      }
    ]
  }
}
